{
  "name": "springboot-launcher",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplifyOurLife/springboot-launcher.git"
  },
  "homepage": "https://simplifyOurLife.github.io/springboot-launcher/",
  "bugs": {
    "url": "https://github.com/simplifyOurLife/springboot-launcher/issues"
  },
  "description": "供 Codex、Claude Code 和网页共用的本地 Spring Boot 启动器",
  "type": "module",
  "bin": {
    "springboot-launcher": "bin/springboot-launcher.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ci": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "license": "Apache-2.0",
  "files": [
    "bin/",
    "src/",
    "web/",
    "scripts/",
    "docs/",
    "documentation/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "examples/demo-service/README.md",
    "examples/demo-service/pom.xml",
    "examples/demo-service/src/"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
